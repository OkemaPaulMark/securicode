# Securicode web app: serves the built SPA and forwards API traffic to the gateway, so the browser only ever
# talks to one origin (no CORS, no token in cookies). ${GATEWAY_URL} is filled in from the environment at start.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 100m;          # CI-4: ZIP uploads up to 100 MB

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Security headers for the app itself (SEC-10), added in the locations below that serve the SPA.
    # Inline style attributes are used by React; inline scripts are not. Proxied gateway responses keep the
    # gateway's own headers (its pages need form-action vscode: for the VS Code sign-in redirect).
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'";

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Gateway: API, server-rendered identity pages, API docs. The gateway sets its own headers on these.
    location ~ ^/(api|auth)/ {
        proxy_pass ${GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_hide_header X-Powered-By;
    }
    location ~ ^/(docs|redoc|openapi\.json)$ {
        proxy_pass ${GATEWAY_URL};
        proxy_set_header Host $host;
    }

    # Hashed build output never changes, so it can be cached for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Single-page app: every other path is a client-side route.
    location / {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri /index.html;
    }
}
